# Nagrik Setu backend configuration. Copy to .env, fill in, then export before starting the backend:
#   set -a; source .env; set +a
# Never commit a real .env file.

# --- Spring profile -----------------------------------------------------------
# dev  = local development (default): enables clearly labelled demo data, dev-only JWT fallback.
# prod = production: no demo data, every secret below is mandatory.
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# --- PostgreSQL ---------------------------------------------------------------
NAGRIK_DB_URL=jdbc:postgresql://localhost:5432/nagrik_setu
NAGRIK_DB_USERNAME=nagrik
NAGRIK_DB_PASSWORD=change-me

# --- Security -----------------------------------------------------------------
# At least 32 random bytes, e.g.: openssl rand -base64 48
NAGRIK_JWT_SECRET=
NAGRIK_JWT_EXPIRY_MINUTES=480
# Comma-separated list of browser origins allowed to call the API (no wildcards).
NAGRIK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Lifetime of signed evidence image URLs.
NAGRIK_EVIDENCE_URL_TTL_SECONDS=600
NAGRIK_RATE_LIMIT_AUTH_PER_MINUTE=20
NAGRIK_RATE_LIMIT_COMPLAINTS_PER_HOUR=20
NAGRIK_RATE_LIMIT_WRITES_PER_MINUTE=120

# --- Uploads ------------------------------------------------------------------
NAGRIK_MAX_FILES_PER_REQUEST=6
NAGRIK_MAX_FILE_SIZE_BYTES=8388608
NAGRIK_MAX_FILE_SIZE=8MB
NAGRIK_MAX_REQUEST_SIZE=60MB

# --- Evidence storage ---------------------------------------------------------
# local = persistent directory on this server; s3 = AWS S3 or any S3-compatible service.
NAGRIK_STORAGE_PROVIDER=local
# Used when provider=local. Relative paths resolve from the backend's working directory.
# Use an absolute path on a persistent, backed-up volume in any shared environment.
NAGRIK_STORAGE_LOCAL_DIR=./storage/evidence

# Used when provider=s3. The bucket must block all public access.
NAGRIK_S3_BUCKET=
NAGRIK_S3_REGION=ap-south-1
# Leave empty for AWS; set for MinIO (http://localhost:9000), Cloudflare R2, DigitalOcean Spaces...
NAGRIK_S3_ENDPOINT=
NAGRIK_S3_PATH_STYLE=false
# Leave both empty to use the default AWS credential chain (instance role, IRSA, env vars).
NAGRIK_S3_ACCESS_KEY=
NAGRIK_S3_SECRET_KEY=
NAGRIK_S3_KEY_PREFIX=evidence/

# Orphaned-file cleanup: removes stored files without an evidence record.
NAGRIK_ORPHAN_CLEANUP_ENABLED=true
NAGRIK_ORPHAN_MIN_AGE_MINUTES=60
NAGRIK_ORPHAN_CLEANUP_CRON=0 17 3 * * *

# --- Ward matching ------------------------------------------------------------
NAGRIK_WARD_MATCHING_ENABLED=true

# --- Demo data (dev profile only) ---------------------------------------------
NAGRIK_DEMO_ENABLED=true
NAGRIK_DEMO_PASSWORD=NagrikDemo@2026

# --- Backend tests ------------------------------------------------------------
NAGRIK_TEST_DB_URL=jdbc:postgresql://localhost:5432/nagrik_setu_test
NAGRIK_TEST_DB_USERNAME=nagrik
NAGRIK_TEST_DB_PASSWORD=nagrik
