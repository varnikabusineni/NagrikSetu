# Frontend build-time settings (copy to .env.local).
# Base URL of the API. Leave empty when the frontend is served from the same origin as /api
# (development uses the Vite proxy below; production typically uses a reverse proxy).
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY=http://127.0.0.1:8080
# How often (ms) notifications are refreshed.
VITE_NOTIFICATION_POLL_MS=30000
